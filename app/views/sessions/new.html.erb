<div class="form-card">
  <h1><%= t(".title") %></h1><p><%= t(".intro") %></p>
  <%= form_with url: session_path, method: :post do |f| %>
    <div class="field"><%= f.label :email, t(".email") %><%= f.email_field :email, required: true, autocomplete: "email" %></div>
    <div class="field"><%= f.label :password, t(".password") %><%= f.password_field :password, required: true, autocomplete: "current-password" %></div>
    <div class="form-actions"><%= f.submit t(".submit"), class: "button" %></div>
  <% end %>
</div>
