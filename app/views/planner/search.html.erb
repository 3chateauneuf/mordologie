<div class="page-head">
  <div>
    <h1><%= t(".title") %></h1>
    <p><%= t(".intro") %></p>
  </div>
  <%= link_to t(".back"), root_path, class: "button secondary" %>
</div>
<div class="search-card">
  <%= form_with url: recherche_path, method: :get, local: true, class: "search-form" do %>
    <div class="field">
      <%= label_tag :q, t(".keyword") %>
      <%= search_field_tag :q, @query, placeholder: t(".keyword_placeholder"), maxlength: 120 %>
    </div>
    <div class="field">
      <%= label_tag :tag, t(".tag") %>
      <%= select_tag :tag, options_for_select([[t(".all_tags"), ""]] + @available_tags.map { |t| ["##{t}", t] }, @tag) %>
    </div>
    <%= submit_tag t(".submit"), class: "button" %>
    <% if @query.present? || @tag.present? %><%= link_to t(".clear"), recherche_path, class: "button secondary" %><% end %>
  <% end %>
  <% if @available_tags.any? %>
    <div class="tag-suggestions" style="margin-top:15px" aria-label="<%= t(".quick_tags") %>">
      <% @available_tags.first(40).each do |tag| %>
        <%= link_to "##{tag}", recherche_path(tag: tag), class: "tag-pill" %>
      <% end %>
    </div>
  <% end %>
</div>
<div class="page-head" style="margin-top:20px">
  <div><h2><%= t(".results", count: "#{@results.length}#{ if @results.length == 100}") %></h2><p><%= t(".results_note") %></p></div>
</div>
<div class="result-list">
  <% if @results.empty? %>
    <div class="search-card"><p class="muted"><%= t(".empty") %></p></div>
  <% else %>
    <% @results.each do |block| %>
      <div class="result">
        <div>
          <strong><%= block.title %></strong>
          <small><%= l(block.start_at.in_time_zone, format: "%d/%m/%Y %H:%M") %> · <%= block.duration_minutes %> min · <%= TimeBlock.category_label(block.category) %></small>
          <% if block.notes.present? %><p class="result-notes"><%= truncate(block.notes, length: 180) %></p><% end %>
          <% if block.tags.any? %>
            <div class="tags-inline">
              <% block.tags.each do |tag| %>
                <%= link_to "##{tag}", recherche_path(tag: tag), class: "tag-pill" %>
              <% end %>
            </div>
          <% end %>
        </div>
        <%= link_to t(".edit"), edit_time_block_path(block), class: "button secondary" %>
      </div>
    <% end %>
  <% end %>
</div>
