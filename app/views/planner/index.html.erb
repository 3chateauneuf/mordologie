<div class="page-head">
  <div><h1>Ma semaine</h1><p>Du <%= @week_start.strftime("%d/%m") %> au <%= (@week_start + 6).strftime("%d/%m/%Y") %> · Organiser, puis comprendre le temps réellement utilisé.</p></div>
  <div class="actions"><%= link_to "+ Planifier un créneau", new_time_block_path(day: Date.current.iso8601), class: "button" %></div>
</div>
<section class="stats" aria-label="Résumé de la semaine">
  <div class="stat"><span>Temps planifié</span><strong><%= number_with_precision(@planned_minutes / 60.0, precision: 1) %> h</strong></div>
  <div class="stat"><span>Temps réalisé (déclaré)</span><strong><%= number_with_precision(@actual_minutes / 60.0, precision: 1) %> h</strong></div>
  <div class="stat"><span>Créneaux</span><strong><%= @blocks.length %></strong></div>
</section>
<div class="calendar-shell">
  <div class="calendar-header">
    <strong>Planning hebdomadaire</strong>
    <div class="week-nav">
      <%= link_to "←", root_path(week: (@week_start - 7).iso8601), aria: { label: "Semaine précédente" } %>
      <%= link_to "Aujourd'hui", root_path %>
      <%= link_to "→", root_path(week: (@week_start + 7).iso8601), aria: { label: "Semaine suivante" } %>
    </div>
  </div>
  <div class="calendar-scroll">
    <div class="week-grid">
      <div class="hour-header"></div>
      <% @days.each_with_index do |day, idx| %>
        <div class="day-heading <%= 'today' if day == Date.current %>">
          <em><%= %w[Lun Mar Mer Jeu Ven Sam Dim][idx] %></em>
          <strong><%= day.day %></strong>
        </div>
      <% end %>
      <div class="time-rail" style="height:<%= @calendar_height %>px">
        <% (@calendar_start_hour...@calendar_end_hour).each do |hour| %><div class="hour"><%= format("%02d:00", hour) %></div><% end %>
      </div>
      <% @days.each do |day| %>
        <div class="day-body <%= 'today' if day == Date.current %>" style="height:<%= @calendar_height %>px" data-day="<%= day.iso8601 %>" data-start-hour="<%= @calendar_start_hour %>" data-end-hour="<%= @calendar_end_hour %>" title="Double-cliquez pour créer un créneau">
          <% @blocks_by_day.fetch(day, []).each do |block| %>
            <% local_start = block.start_at.in_time_zone %>
            <% start_minutes = ((local_start.hour - @calendar_start_hour) * 60 + local_start.min) %>
            <% top = start_minutes * 1.1 %>
            <% height = [[block.duration_minutes * 1.1, 34].max, [@calendar_height - top, 15].max].min %>
            <%= link_to edit_time_block_path(block), class: "event", style: "top:#{top}px;height:#{height}px;--event-color:#{block.color}", title: "#{block.title} — Modifier" do %>
              <span class="category"><%= TimeBlock::CATEGORIES.fetch(block.category)[:label] %></span>
              <strong><%= block.title %></strong>
              <% if height >= 64 %><small><%= local_start.strftime("%H:%M") %> – <%= block.end_at.in_time_zone.strftime("%H:%M") %></small><% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <p class="help">Double-cliquez sur un espace libre pour ajouter un créneau · Cliquez sur un bloc pour le modifier. Glisser-déposer et synchronisation Google Calendar viendront ensuite.</p>
</div>
<script>
  document.querySelectorAll(".day-body").forEach(function(day) {
    day.addEventListener("dblclick", function(event) {
      if (event.target.closest(".event")) return;
      const bounds = day.getBoundingClientRect();
      const firstHour = Number(day.dataset.startHour);
      const lastHour = Number(day.dataset.endHour);
      const hour = Math.min(lastHour - 1, Math.max(firstHour, firstHour + Math.floor((event.clientY - bounds.top) / 66)));
      window.location.href = "/time_blocks/new?day=" + encodeURIComponent(day.dataset.day) + "&hour=" + hour;
    });
  });
</script>
