<div class="page-head">
  <div><h1 class="planner-page-title">Ma semaine <span class="week-number">Semana <%= @week_start.cweek %></span></h1><p>Du <%= @week_start.strftime("%d/%m") %> au <%= (@week_start + 6).strftime("%d/%m/%Y") %> · Organiser, puis comprendre le temps réellement utilisé.</p></div>
  <div class="actions"><%= link_to "Rechercher", recherche_path, class: "button secondary" %><%= link_to "+ Planifier un créneau", new_time_block_path(day: Date.current.iso8601), class: "button" %></div>
</div>
<section class="stats" aria-label="Résumé de la semaine">
  <div class="stat"><span>Planifié</span><strong><%= planner_duration(@planned_minutes) %></strong></div>
  <div class="stat"><span title="Temps réellement déclaré">Réalisé</span><strong><%= planner_duration(@actual_minutes) %></strong></div>
  <div class="stat"><span>Créneaux</span><strong><%= @blocks.length %></strong></div>
</section>
<div class="calendar-shell">
  <div class="calendar-header">
    <strong><span class="desktop-calendar-label">Planning hebdomadaire</span><span class="mobile-calendar-label">Agenda</span></strong>
    <div class="week-nav">
      <%= link_to "←", root_path(week: (@week_start - 7).iso8601), aria: { label: "Semaine précédente" } %>
      <%= link_to "Aujourd'hui", root_path %>
      <%= link_to "→", root_path(week: (@week_start + 7).iso8601), aria: { label: "Semaine suivante" } %>
    </div>
  </div>
  <nav class="mobile-day-picker" aria-label="Choisir un jour de la semaine">
    <% @days.each_with_index do |day, idx| %>
      <%= link_to root_path(week: @week_start.iso8601, day: day.iso8601),
          class: "mobile-day #{'is-selected' if day == @selected_day}",
          aria: { current: (day == @selected_day ? "date" : nil), label: "#{%w[Lundi Mardi Mercredi Jeudi Vendredi Samedi Dimanche][idx]} #{day.day}" } do %>
        <span class="mobile-day-label"><%= %w[L M M J V S D][idx] %></span>
        <strong><%= day.day %></strong>
        <% if @blocks_by_day.fetch(day, []).any? %><span class="mobile-day-dot" aria-hidden="true"></span><% end %>
      <% end %>
    <% end %>
  </nav>
  <div class="calendar-scroll">
    <div class="week-grid">
      <div class="hour-header"></div>
      <% @days.each_with_index do |day, idx| %>
        <div class="day-heading <%= 'today' if day == Date.current %> <%= 'is-active-day' if day == @selected_day %>">
          <em><%= %w[Lun Mar Mer Jeu Ven Sam Dim][idx] %></em>
          <strong><%= day.day %></strong>
        </div>
      <% end %>
      <div class="time-rail" style="height:<%= @calendar_height %>px">
        <% (@calendar_start_hour...@calendar_end_hour).each do |hour| %><div class="hour"><%= format("%02d:00", hour) %></div><% end %>
      </div>
      <% @days.each do |day| %>
        <div class="day-body <%= 'today' if day == Date.current %> <%= 'is-active-day' if day == @selected_day %>" style="height:<%= @calendar_height %>px" data-first-event-hour="<%= @blocks_by_day.fetch(day, []).first&.start_at&.in_time_zone&.hour || 8 %>" data-day="<%= day.iso8601 %>" data-start-hour="<%= @calendar_start_hour %>" data-end-hour="<%= @calendar_end_hour %>" title="Glissez pour choisir une durée ou double-cliquez pour créer un créneau">
          <% @blocks_by_day.fetch(day, []).each do |block| %>
            <% local_start = block.start_at.in_time_zone %>
            <% start_minutes = ((local_start.hour - @calendar_start_hour) * 60 + local_start.min) %>
            <% top = start_minutes * 1.1 %>
            <% height = [[block.duration_minutes * 1.1, 34].max, [@calendar_height - top, 15].max].min %>
            <% category_label = TimeBlock::CATEGORIES.fetch(block.category)[:label] %>
            <% time_label = "#{local_start.strftime('%H:%M')} – #{block.end_at.in_time_zone.strftime('%H:%M')}" %>
            <%= link_to edit_time_block_path(block), class: "event", style: "top:#{top}px;height:#{height}px;--event-color:#{block.color}", title: "#{block.title} · #{time_label} · #{category_label}#{block.tags.any? ? ' · #' + block.tags.join(' #') : ''} — Modifier" do %>
              <strong><%= block.title %></strong>
              <% if height >= 55 %><small><%= time_label %></small><% end %>
              <% if height >= 82 %><span class="category"><%= category_label %></span><% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <p class="help"><span class="desktop-help">Glissez sur un espace libre pour choisir un horaire, ou double-cliquez pour créer une heure. Cliquez sur un bloc pour le modifier.</span><span class="mobile-help">Touchez une heure libre pour ajouter un créneau. Touchez un bloc pour le modifier.</span></p>
</div>
<script>
(function () {
  // On small screens show one selected day and position the scroll near
  // its earliest event rather than forcing a long scroll from midnight.
  const mobileCalendar = document.querySelector(".calendar-scroll");
  const activeDay = document.querySelector(".day-body.is-active-day");
  if (mobileCalendar && activeDay && window.matchMedia("(max-width:720px)").matches) {
    const first = Number(activeDay.dataset.firstEventHour);
    const startHour = Number(activeDay.dataset.startHour);
    mobileCalendar.scrollTop = Math.max(0, (Math.max(first, startHour) - startHour) * 66 - 28);
  }

  // Each grid hour is 66 px. Snap both clicks and selections to 15 minutes.
  const slotPixels = 66 / 4;
  const scheduleUrl = <%= new_time_block_path.to_json.html_safe %>;
  let selection = null;
  let touchPoint = null;

  function slotAt(event, day) {
    const rect = day.getBoundingClientRect();
    const maxSlot = (Number(day.dataset.endHour) - Number(day.dataset.startHour)) * 4 - 1;
    return Math.max(0, Math.min(maxSlot, Math.floor((event.clientY - rect.top) / slotPixels)));
  }

  function openForm(day, firstSlot, slotCount) {
    const startMinutes = Number(day.dataset.startHour) * 60 + firstSlot * 15;
    const hour = Math.floor(startMinutes / 60);
    const minute = startMinutes % 60;
    const untilMidnight = 1440 - startMinutes - 1;
    const duration = Math.max(1, Math.min(slotCount * 15, 960, untilMidnight));
    const url = new URL(scheduleUrl, window.location.origin);
    url.searchParams.set("day", day.dataset.day);
    url.searchParams.set("hour", String(hour));
    url.searchParams.set("minute", String(minute));
    url.searchParams.set("duration", String(duration));
    window.location.assign(url.toString());
  }

  function clearSelection() {
    if (selection && selection.preview) selection.preview.remove();
    selection = null;
  }

  document.querySelectorAll(".day-body").forEach(function (day) {
    day.addEventListener("pointerdown", function (event) {
      if (event.pointerType === "touch" && !event.target.closest(".event")) {
        touchPoint = { id: event.pointerId, day: day, slot: slotAt(event, day), y: event.clientY, x: event.clientX };
        return;
      }
      if (event.pointerType !== "mouse" || event.button !== 0 || event.target.closest(".event")) return;
      clearSelection();
      selection = {
        day: day,
        first: slotAt(event, day),
        last: slotAt(event, day),
        originY: event.clientY,
        dragging: false,
        preview: document.createElement("div")
      };
      selection.preview.className = "selection-preview";
    });

    // A double click creates a one-hour block; dragging selects any
    // 15-minute multiple, with exact values editable in the form.
    day.addEventListener("dblclick", function (event) {
      if (event.target.closest(".event")) return;
      openForm(day, slotAt(event, day), 4);
    });
  });

  document.addEventListener("pointermove", function (event) {
    if (touchPoint && event.pointerId === touchPoint.id &&
        (Math.abs(event.clientY - touchPoint.y) > 12 || Math.abs(event.clientX - touchPoint.x) > 12)) {
      touchPoint = null; // Scrolling isn't a tap.
    }
    if (!selection || event.pointerType !== "mouse") return;
    if (Math.abs(event.clientY - selection.originY) < 8 && !selection.dragging) return;
    selection.dragging = true;
    selection.last = slotAt(event, selection.day);
    const first = Math.min(selection.first, selection.last);
    const last = Math.max(selection.first, selection.last);
    selection.preview.style.top = String(first * slotPixels) + "px";
    selection.preview.style.height = String((last - first + 1) * slotPixels) + "px";
    selection.day.appendChild(selection.preview);
  });

  document.addEventListener("pointerup", function (event) {
    if (touchPoint && event.pointerId === touchPoint.id) {
      const tapped = touchPoint;
      touchPoint = null;
      openForm(tapped.day, tapped.slot, 4);
      return;
    }
    if (!selection) return;
    const current = selection;
    if (current.dragging) {
      event.preventDefault();
      const first = Math.min(current.first, current.last);
      const count = Math.max(current.first, current.last) - first + 1;
      clearSelection();
      openForm(current.day, first, count);
    } else {
      clearSelection();
    }
  });
  document.addEventListener("pointercancel", function () {
    touchPoint = null;
    clearSelection();
  });
  window.addEventListener("blur", clearSelection);
})();
</script>
