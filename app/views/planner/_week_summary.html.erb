<section class="stats" aria-label="<%= t(".label") %>">
  <div class="stat"><span><%= t(".planned") %></span><strong><%= planner_duration(@planned_minutes) %></strong></div>
  <div class="stat"><span title="<%= t(".actual_hint") %>"><%= t(".actual") %></span><strong><%= planner_duration(@actual_minutes) %></strong></div>
  <div class="stat"><span><%= t(".blocks") %></span><strong><%= @blocks.length %></strong></div>
</section>
