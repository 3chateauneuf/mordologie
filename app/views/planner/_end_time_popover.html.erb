<%# Shared editor opened from a block's end time (see calendar-end-time.js). %>
<div class="end-time-popover" data-end-time-popover hidden
     role="dialog" aria-modal="false" aria-labelledby="end-time-popover-title">
  <p class="end-time-popover-title" id="end-time-popover-title" data-end-time-title><%= t(".title") %></p>
  <p class="end-time-popover-hint" data-end-time-hint></p>
  <label class="end-time-popover-field">
    <span><%= t(".end_time") %></span>
    <input type="time" required data-end-time-input>
  </label>
  <div class="end-time-quick" role="group" aria-label="<%= t(".extend") %>">
    <button type="button" data-end-time-add="15">+15 min</button>
    <button type="button" data-end-time-add="30">+30 min</button>
    <button type="button" data-end-time-add="60">+1 h</button>
  </div>
  <button type="button" class="end-time-finish-now" data-end-time-finish-now hidden><%= t(".finish_now") %></button>
  <div class="end-time-actions">
    <button type="button" data-end-time-cancel><%= t(".cancel") %></button>
    <button type="button" class="is-primary" data-end-time-save><%= t(".save") %></button>
  </div>
</div>
