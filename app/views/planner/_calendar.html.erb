<div class="calendar-shell" data-calendar data-new-block-url="<%= new_time_block_path %>">
  <div class="calendar-header">
    <strong><span class="desktop-calendar-label"><%= t(".title") %></span><span class="mobile-calendar-label"><%= t(".title_mobile") %></span></strong>
    <%= form_with url: calendar_preferences_path, method: :patch, class: "calendar-start-form", data: { calendar_start_form: true } do %>
      <%= hidden_field_tag :week, @week_start.iso8601 %>
      <%= hidden_field_tag :day, @selected_day.iso8601 %>
      <%= label_tag :calendar_start_hour, t(".start") %>
      <%= select_tag :calendar_start_hour,
            options_for_select(User::CALENDAR_START_HOURS.map { |hour| [format("%02d:00", hour), hour] }, current_user.calendar_start_hour),
            aria: { label: t(".start_label") } %>
      <%= label_tag :locale, t(".language"), class: "calendar-language-label" %>
      <%= select_tag :locale,
            options_for_select(User::LOCALES.map { |code| [t("locales.#{code}"), code] }, current_user.locale) %>
      <%= button_tag t(".apply"), type: "submit" %>
    <% end %>
    <div class="week-nav">
      <%= link_to "←", root_path(week: (@week_start - 7).iso8601), aria: { label: t(".previous_week") } %>
      <%= link_to t(".today"), root_path %>
      <%= link_to "→", root_path(week: (@week_start + 7).iso8601), aria: { label: t(".next_week") } %>
    </div>
  </div>
  <% if @earlier_blocks.any? %>
    <div class="calendar-earlier-bar">
      <% start_hour = format("%02d:00", current_user.calendar_start_hour) %>
      <span><%= t(".earlier", count: @earlier_blocks.length, hour: start_hour) %></span>
      <% if @show_early %>
        <%= link_to t(".back_to", hour: start_hour),
              root_path(week: @week_start.iso8601, day: @selected_day.iso8601) %>
      <% else %>
        <%= link_to t(".show_earlier"),
              root_path(week: @week_start.iso8601, day: @selected_day.iso8601, show_early: "1") %>
      <% end %>
    </div>
  <% end %>
  <nav class="mobile-day-picker" aria-label="<%= t(".choose_day") %>">
    <% @days.each do |day| %>
      <%= link_to root_path(week: @week_start.iso8601, day: day.iso8601, show_early: (@show_early ? "1" : nil)),
          class: "mobile-day #{'is-selected' if day == @selected_day}",
          aria: { current: (day == @selected_day ? "date" : nil), label: "#{planner_weekday(day, :long)} #{day.day}" } do %>
        <span class="mobile-day-label"><%= planner_weekday(day, :letter) %></span>
        <strong><%= day.day %></strong>
        <% if @blocks_by_day.fetch(day, []).any? %><span class="mobile-day-dot" aria-hidden="true"></span><% end %>
      <% end %>
    <% end %>
  </nav>
  <div class="calendar-scroll">
    <div class="week-grid">
      <div class="hour-header"></div>
      <% @days.each do |day| %>
        <div class="day-heading <%= 'today' if day == Date.current %> <%= 'is-active-day' if day == @selected_day %>">
          <em><%= planner_weekday(day) %></em>
          <strong><%= day.day %></strong>
        </div>
      <% end %>
      <div class="time-rail" style="height:<%= @calendar_height %>px">
        <% (@calendar_start_hour...@calendar_end_hour).each do |hour| %><div class="hour"><%= format("%02d:00", hour) %></div><% end %>
      </div>
      <% @days.each do |day| %>
        <div class="day-body <%= 'today' if day == Date.current %> <%= 'is-active-day' if day == @selected_day %>" style="height:<%= @calendar_height %>px" data-first-event-hour="<%= @blocks_by_day.fetch(day, []).first&.start_at&.in_time_zone&.hour || 8 %>" data-day="<%= day.iso8601 %>" data-start-hour="<%= @calendar_start_hour %>" data-end-hour="<%= @calendar_end_hour %>" title="<%= t(".day_hint") %>">
          <% @day_layouts.fetch(day).entries.each do |entry| %>
            <%= render "calendar_event", entry: entry %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <%= render "return_to_inbox_forms" %>
  <%= render "reschedule_forms" %>
  <%= render "end_time_forms" %>
  <%= render "duplicate_forms" %>
  <%= render "history_forms" %>
  <%= render "end_time_popover" %>
  <p class="help"><span class="desktop-help"><%= t(".help_desktop") %></span><span class="mobile-help"><%= t(".help_mobile") %></span></p>
</div>
