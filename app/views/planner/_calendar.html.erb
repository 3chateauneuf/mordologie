<div class="calendar-shell" data-calendar data-new-block-url="<%= new_time_block_path %>">
  <nav class="mobile-day-picker" aria-label="<%= t(".choose_day") %>">
    <% @days.each do |day| %>
      <%= link_to root_path(week: @week_start.iso8601, day: day.iso8601),
          class: "mobile-day #{'is-selected' if day == @selected_day}",
          aria: { current: (day == @selected_day ? "date" : nil), label: "#{planner_weekday(day, :long)} #{day.day}" } do %>
        <span class="mobile-day-label"><%= planner_weekday(day, :letter) %></span>
        <strong><%= day.day %></strong>
        <% if @blocks_by_day.fetch(day, []).any? %><span class="mobile-day-dot" aria-hidden="true"></span><% end %>
      <% end %>
    <% end %>
  </nav>
  <%# calendar-scroll-anchor.js opens the grid at data-scroll-hour. %>
  <div class="calendar-scroll" data-calendar-scroll data-scroll-hour="<%= @scroll_hour %>">
    <div class="week-grid">
      <div class="hour-header"></div>
      <% @days.each do |day| %>
        <% totals = @day_totals.fetch(day) %>
        <div class="day-heading <%= 'today' if day == Date.current %> <%= 'is-active-day' if day == @selected_day %>">
          <em><%= planner_weekday(day) %></em>
          <strong><%= day.day %></strong>
          <% if totals[:actual].positive? %>
            <small class="day-totals" title="<%= t(".day_totals_hint") %>"><%= t(".day_totals", actual: planner_duration(totals[:actual]), planned: planner_duration(totals[:planned])) %></small>
          <% elsif totals[:planned].positive? %>
            <small class="day-totals"><%= t(".day_planned", planned: planner_duration(totals[:planned])) %></small>
          <% end %>
        </div>
      <% end %>
      <div class="time-rail" style="height:<%= @calendar_height %>px">
        <% (@calendar_start_hour...@calendar_end_hour).each do |hour| %><div class="hour"><%= format("%02d:00", hour) %></div><% end %>
      </div>
      <% @days.each do |day| %>
        <div class="day-body <%= 'today' if day == Date.current %> <%= 'is-active-day' if day == @selected_day %>" style="height:<%= @calendar_height %>px" data-day="<%= day.iso8601 %>" data-start-hour="<%= @calendar_start_hour %>" data-end-hour="<%= @calendar_end_hour %>">
          <% @day_layouts.fetch(day).entries.each do |entry| %>
            <%= render "calendar_event", entry: entry %>
          <% end %>
          <% if day == Date.current %>
            <%# Placed and kept up to date by calendar-now-line.js. %>
            <div class="now-line" data-now-line data-time-zone="<%= Time.zone.tzinfo.name %>" hidden aria-hidden="true"><span data-now-line-time></span></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
  <%= render "return_to_inbox_forms" %>
  <%= render "reschedule_forms" %>
  <%= render "end_time_forms" %>
  <%= render "duplicate_forms" %>
  <%= render "history_forms" %>
  <%= render "end_time_popover" %>
  <%= render "event_hovercard" %>
</div>
