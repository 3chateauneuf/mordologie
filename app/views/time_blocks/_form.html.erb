<%= form_with model: @block, html: { id: "planner-time-block-form", class: "editor-form", data: { schedule_form: true } } do |f| %>
  <%= hidden_field_tag :planning_task_id, @planning_task.id if @planning_task %>
  <%= hidden_field_tag :schedule_mode, schedule_mode if @block.persisted? %>
  <% if @block.errors.any? %>
    <div class="editor-error" role="alert">
      <strong><%= t(".check") %></strong>
      <ul><% @block.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <div class="editor-core">
    <div class="editor-field editor-title-field">
      <%= f.label :title, t(".activity") %>
      <%= f.text_field :title, required: true, maxlength: 120, autocomplete: "off", placeholder: t(".activity_placeholder") %>
    </div>

    <% if @edits_actual %>
      <%# Once a block has started, these fields are what really happened. %>
      <p class="editor-actual-note"><%= t(".editing_actual", planned: "#{@block.start_at.in_time_zone.strftime('%H:%M')} – #{@block.end_at.in_time_zone.strftime('%H:%M')}") %></p>
    <% end %>
    <div class="editor-schedule-row">
      <div class="editor-field">
        <%= label_tag :time_block_schedule_date, t(".date") %>
        <%= date_field_tag "time_block[schedule_date]", @schedule_date, id: "time_block_schedule_date", required: true %>
      </div>
      <div class="editor-field">
        <%= label_tag :time_block_start_clock, t(".start") %>
        <%= time_field_tag "time_block[start_clock]", @start_clock, id: "time_block_start_clock", required: true, step: 60 %>
      </div>
    </div>

    <div class="editor-field editor-duration-field">
      <%= label_tag :time_block_duration_minutes, t(".duration") %>
      <div class="duration-picks" role="group" aria-label="<%= t(".quick_durations") %>">
        <% [[15, "15 min"], [30, "30 min"], [60, "1 h"], [90, "1 h 30"], [120, "2 h"]].each do |minutes, label| %>
          <button type="button" class="duration-pick" data-duration="<%= minutes %>" aria-pressed="false"><%= label %></button>
        <% end %>
      </div>
      <div class="editor-duration-bottom">
        <div class="editor-custom-duration">
          <span><%= @edits_actual ? t(".actual_duration_label") : t(".planned_duration") %></span>
          <%= number_field_tag "time_block[duration_minutes]", @duration_minutes, id: "time_block_duration_minutes", required: true, min: 1, max: longest_duration, step: 1, aria: { label: t(".duration_minutes") } %>
          <span>min</span>
        </div>
        <%# Editing the end recalculates the duration (time-block-form.js);
            the duration is what the server receives. %>
        <div class="editor-end">
          <label for="time_block_end_clock"><%= t(".end") %></label>
          <input type="time" id="time_block_end_clock" step="60" data-end-input>
          <span class="editor-end-message" data-end-message role="status" aria-live="polite"></span>
        </div>
      </div>
    </div>

    <fieldset class="editor-field editor-categories">
      <legend><%= t(".category") %></legend>
      <div class="editor-category-grid">
        <% TimeBlock::CATEGORIES.each do |key, data| %>
          <label class="editor-category-choice" style="--category-color:<%= data[:color] %>">
            <%= f.radio_button :category, key, required: true %>
            <span class="category-choice-inner"><span class="category-color"></span><%= TimeBlock.category_label(key) %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="editor-field editor-tags-field">
      <label for="time_block_tag_list"><%= t(".tags") %> <span class="editor-optional"><%= t(".optional") %></span></label>
      <div class="tag-editor" data-tags-editor>
        <%= text_field_tag "time_block[tag_list]", @block.tag_list, id: "time_block_tag_list", class: "tag-source", maxlength: 550, autocomplete: "off", placeholder: t(".tags_placeholder") %>
        <div class="tag-editor-chips" data-tag-chips></div>
        <input type="text" class="tag-entry" data-tag-entry placeholder="<%= t(".add_tag") %>" aria-label="<%= t(".add_tag_label") %>" maxlength="40" hidden>
      </div>
      <% if @suggested_tags.present? %>
        <details class="editor-tag-reuse">
          <summary><%= t(".reuse_tag") %></summary>
          <div class="tag-suggestions">
            <% @suggested_tags.each do |tag| %>
              <button type="button" class="tag-pill" data-suggest-tag="<%= tag %>">#<%= tag %></button>
            <% end %>
          </div>
        </details>
      <% end %>
      <p class="editor-tag-message" role="status" aria-live="polite" data-tag-message></p>
    </div>

    <div class="editor-field editor-notes-field">
      <%= f.label :notes do %><%= t(".notes") %> <span class="editor-optional"><%= t(".optional") %></span><% end %>
      <%= f.text_area :notes, rows: 2, placeholder: t(".notes_placeholder") %>
    </div>
  </div>


<% end %>

<footer class="editor-footer <%= 'editor-footer-edit editor-footer-with-actions' if @block.persisted? %>">
  <% if @block.persisted? %>
    <div class="editor-delete-zone">
      <%= button_to t(".return_to_inbox"), return_to_inbox_time_block_path(@block),
            method: :post, class: "editor-standby-button" %>
      <%= button_to t(".delete"), time_block_path(@block),
            method: :delete, class: "editor-delete-button",
            form: { data: { confirm_destroy: t(".delete_confirm") } } %>
    </div>
  <% end %>
  <button type="submit" form="planner-time-block-form" id="planner-time-block-submit" class="editor-submit"><%= @block.persisted? ? t(".save") : t(".create") %></button>
</footer>
