<%= form_with model: @block, html: { id: "planner-time-block-form", class: "editor-form", data: { schedule_form: true } } do |f| %>
  <% if @block.errors.any? %>
    <div class="editor-error" role="alert">
      <strong>Vérifiez les informations :</strong>
      <ul><% @block.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <div class="editor-core">
    <div class="editor-field editor-title-field">
      <%= f.label :title, "Activité" %>
      <%= f.text_field :title, required: true, maxlength: 120, autocomplete: "off", placeholder: "Que voulez-vous faire ?" %>
    </div>

    <div class="editor-schedule-row">
      <div class="editor-field">
        <%= label_tag :time_block_schedule_date, "Date" %>
        <%= date_field_tag "time_block[schedule_date]", @schedule_date, id: "time_block_schedule_date", required: true %>
      </div>
      <div class="editor-field">
        <%= label_tag :time_block_start_clock, "Début" %>
        <%= time_field_tag "time_block[start_clock]", @start_clock, id: "time_block_start_clock", required: true, step: 60 %>
      </div>
    </div>

    <div class="editor-field editor-duration-field">
      <%= label_tag :time_block_duration_minutes, "Durée" %>
      <div class="duration-picks" role="group" aria-label="Durées rapides">
        <% [[15, "15 min"], [30, "30 min"], [60, "1 h"], [90, "1 h 30"], [120, "2 h"]].each do |minutes, label| %>
          <button type="button" class="duration-pick" data-duration="<%= minutes %>" aria-pressed="false"><%= label %></button>
        <% end %>
      </div>
      <div class="editor-duration-bottom">
        <div class="editor-custom-duration">
          <span>Autre durée</span>
          <%= number_field_tag "time_block[duration_minutes]", @duration_minutes, id: "time_block_duration_minutes", required: true, min: 1, max: 960, step: 1, aria: { label: "Durée en minutes" } %>
          <span>min</span>
        </div>
        <div class="editor-end" role="status" aria-live="polite">
          <span>Fin</span>
          <strong data-end-preview>—</strong>
        </div>
      </div>
    </div>

    <fieldset class="editor-field editor-categories">
      <legend>Catégorie</legend>
      <div class="editor-category-grid">
        <% TimeBlock::CATEGORIES.each do |key, data| %>
          <label class="editor-category-choice" style="--category-color:<%= data[:color] %>">
            <%= f.radio_button :category, key, required: true %>
            <span class="category-choice-inner"><span class="category-color"></span><%= data[:label] %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="editor-field editor-tags-field">
      <label for="time_block_tag_list">Tags <span class="editor-optional">· facultatif</span></label>
      <div class="tag-editor" data-tags-editor>
        <%= text_field_tag "time_block[tag_list]", @block.tag_list, id: "time_block_tag_list", class: "tag-source", maxlength: 550, autocomplete: "off", placeholder: "Ex. vidéo, youtube, sin rueditas" %>
        <div class="tag-editor-chips" data-tag-chips></div>
        <input type="text" class="tag-entry" data-tag-entry placeholder="+ Ajouter un tag" aria-label="Ajouter un tag puis Entrée" maxlength="40" hidden>
      </div>
      <% if @suggested_tags.present? %>
        <details class="editor-tag-reuse">
          <summary>Réutiliser un tag</summary>
          <div class="tag-suggestions">
            <% @suggested_tags.each do |tag| %>
              <button type="button" class="tag-pill" data-suggest-tag="<%= tag %>">#<%= tag %></button>
            <% end %>
          </div>
        </details>
      <% end %>
      <p class="editor-tag-message" role="status" aria-live="polite" data-tag-message></p>
    </div>
  </div>

  <details class="editor-details" <%= "open" if @block.notes.present? || @block.actual_minutes.present? %>>
    <summary>Notes et temps réel <span>Facultatif</span></summary>
    <div class="editor-details-content">
      <div class="editor-field">
        <%= f.label :notes, "Notes" %>
        <%= f.text_area :notes, rows: 3, placeholder: "Informations utiles pour cette activité" %>
      </div>
      <div class="editor-field">
        <%= f.label :actual_minutes, "Temps réalisé" %>
        <div class="editor-actual-row">
          <%= f.number_field :actual_minutes, min: 0, placeholder: "—" %>
          <span>minutes</span>
        </div>
      </div>
    </div>
  </details>

<% end %>

<footer class="editor-footer <%= 'editor-footer-edit' if @block.persisted? %>">
  <% if @block.persisted? %>
    <div class="editor-delete-zone">
      <%= button_to "Supprimer ce créneau", time_block_path(@block), method: :delete, class: "editor-delete-button", form: { onsubmit: "return window.confirm('Supprimer définitivement ce créneau ?')" } %>
    </div>
  <% end %>
  <button type="submit" form="planner-time-block-form" id="planner-time-block-submit" class="editor-submit"><%= @block.persisted? ? "Enregistrer" : "Créer le créneau" %></button>
</footer>
