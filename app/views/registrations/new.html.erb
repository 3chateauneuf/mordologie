<div class="form-card">
  <h1>Initialiser Planner</h1><p>Créez votre compte personnel. Cette page est désactivée après la première inscription.</p>
  <% if @user.errors.any? %><div class="error-list"><ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <%= form_with model: @user, url: setup_path, method: :post do |f| %>
    <div class="field"><%= label_tag :setup_token, "Code d'installation" %><%= password_field_tag :setup_token, nil, required: true, autocomplete: "off" %></div>
    <div class="field"><%= f.label :email, "Email" %><%= f.email_field :email, required: true, autocomplete: "email" %></div>
    <div class="field"><%= f.label :password, "Mot de passe (12 caractères minimum)" %><%= f.password_field :password, required: true, autocomplete: "new-password", minlength: 12 %></div>
    <div class="field"><%= f.label :password_confirmation, "Confirmer le mot de passe" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
    <div class="form-actions"><%= f.submit "Créer mon compte", class: "button" %></div>
  <% end %>
  <p class="form-note">Vos informations sont stockées sur le serveur Planner, distinct de l'ancienne base Mordologie.</p>
</div>
