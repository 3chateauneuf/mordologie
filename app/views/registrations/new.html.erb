<div class="form-card">
  <h1><%= t(".title") %></h1><p><%= t(".intro") %></p>
  <% if @user.errors.any? %><div class="error-list"><ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <%= form_with model: @user, url: setup_path, method: :post do |f| %>
    <div class="field"><%= label_tag :setup_token, t(".setup_token") %><%= password_field_tag :setup_token, nil, required: true, autocomplete: "off" %></div>
    <div class="field"><%= f.label :email, t(".email") %><%= f.email_field :email, required: true, autocomplete: "email" %></div>
    <div class="field"><%= f.label :password, t(".password") %><%= f.password_field :password, required: true, autocomplete: "new-password", minlength: 12 %></div>
    <div class="field"><%= f.label :password_confirmation, t(".password_confirmation") %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
    <div class="form-actions"><%= f.submit t(".submit"), class: "button" %></div>
  <% end %>
  <p class="form-note"><%= t(".note") %></p>
</div>
