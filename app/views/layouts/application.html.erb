<!doctype html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f6f9">
  <title><%= t(".title") %></title>
  <link rel="stylesheet" href="<%= planner_asset("/styles/foundation.css") %>">
  <link rel="stylesheet" href="<%= planner_asset("/styles/time-block-editor.css") %>">
  <link rel="stylesheet" href="<%= planner_asset("/styles/mobile.css") %>">
  <link rel="stylesheet" href="<%= planner_asset("/styles/dialogs.css") %>">
  <% if controller_name == "planner" && action_name == "index" %>
    <link rel="stylesheet" href="<%= planner_asset("/styles/pending-tasks.css") %>">
    <link rel="stylesheet" href="<%= planner_asset("/styles/calendar-block-move.css") %>">
    <link rel="stylesheet" href="<%= planner_asset("/styles/calendar-end-time.css") %>">
    <link rel="stylesheet" href="<%= planner_asset("/styles/planner-toolbar.css") %>">
    <link rel="stylesheet" href="<%= planner_asset("/styles/calendar-events.css") %>">
  <% end %>
  <%# Loaded first: the other scripts read their texts through it. %>
  <script src="<%= planner_asset("/scripts/i18n.js") %>" defer></script>
  <script src="<%= planner_asset("/scripts/wall-clock.js") %>" defer></script>
  <script src="<%= planner_asset("/planner-dialog.js") %>" defer></script>
  <script src="<%= planner_asset("/scripts/confirm-destroy.js") %>" defer></script>
  <% if controller_name == "time_blocks" %>
    <script src="<%= planner_asset("/scripts/time-block-form.js") %>" defer></script>
  <% elsif controller_name == "planner" && action_name == "index" %>
    <script src="<%= planner_asset("/scripts/week-calendar.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/pending-calendar-drag.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-to-inbox.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-block-move.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-end-time.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-history.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-preferences.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-now-line.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-scroll-anchor.js") %>" defer></script>
    <script src="<%= planner_asset("/scripts/calendar-hovercard.js") %>" defer></script>
  <% end %>
</head>
<body data-i18n="<%= planner_js_translations.to_json %>" class="<%= controller_name == 'time_blocks' ? 'is-editor-page' : '' %> <%= controller_name == 'time_blocks' && %w[new create edit update].include?(action_name) ? 'is-dialog-page' : '' %>">
  <header class="topbar">
    <a href="<%= root_path %>" class="brand"><span class="brand-mark">P</span><span class="brand-name">Planner</span></a>
    <% if current_user && content_for?(:toolbar) %>
      <%= yield :toolbar %>
    <% elsif current_user %>
      <div class="nav-links"><%= link_to t(".planning"), root_path, class: controller_name == "planner" && action_name == "index" ? "active" : "" %><%= link_to t(".search"), recherche_path, class: action_name == "search" ? "active" : "" %><%= link_to t(".new_block"), new_time_block_path %></div>
      <div class="account"><span><%= current_user.email %></span><%= button_to t(".logout"), session_path, method: :delete %></div>
      <details class="mobile-menu">
        <summary aria-label="<%= t(".open_menu") %>">☰</summary>
        <div class="mobile-menu-panel">
          <%= link_to t(".planning"), root_path %>
          <%= link_to t(".search"), recherche_path %>
          <%= link_to t(".new_block_long"), new_time_block_path %>
          <%= button_to t(".logout"), session_path, method: :delete %>
        </div>
      </details>
    <% end %>
  </header>
  <main>
    <% if notice %><div class="flash"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert"><%= alert %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
