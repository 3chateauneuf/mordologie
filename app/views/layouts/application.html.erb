<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f6f9">
  <title>Planner — Organiser le temps</title>
  <style>
    :root { --ink:#151c2c; --sub:#6c7688; --line:#e7ebf1; --bg:#f5f6f9; --brand:#5268ca; }
    * {box-sizing:border-box}
    body {margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
    a {color:inherit;text-decoration:none}
    button,input,select,textarea {font:inherit}
    button {cursor:pointer}
    .topbar {height:72px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 32px;gap:20px}
    .brand {display:flex;align-items:center;gap:11px;font-size:21px;letter-spacing:-.8px;font-weight:800}
    .brand-mark {display:grid;place-items:center;width:34px;height:34px;border-radius:11px;color:white;background:var(--brand);font-size:20px}
    .nav-links {display:flex;gap:12px;align-items:center}
    .nav-links a {color:#5e687c;padding:8px 10px;border-radius:8px}
    .nav-links a.active {color:var(--brand);background:#eff1fe;font-weight:700}
    .account {display:flex;gap:12px;align-items:center;font-size:12px;color:var(--sub)}
    .account button {border:0;background:none;color:#667085}
    main {max-width:1480px;margin:0 auto;padding:28px 30px}
    h1 {font-size:30px;letter-spacing:-1px;line-height:1.18;margin:0}
    .planner-page-title {display:flex;align-items:center;flex-wrap:wrap;gap:12px}
    .week-number {display:inline-flex;align-items:center;background:#e7ebf8;border:1px solid #d5ddf3;border-radius:9px;padding:6px 10px;color:#455aaf;font-size:13px;font-weight:750;letter-spacing:0;white-space:nowrap}

    h2 {font-size:16px;margin:0}
    p {margin:0}
    .muted {color:var(--sub)}
    .button {display:inline-flex;align-items:center;gap:8px;justify-content:center;border:1px solid transparent;border-radius:10px;padding:11px 16px;background:var(--brand);color:white;font-weight:700;cursor:pointer}
    .button.secondary {background:white;color:var(--ink);border-color:#dfe4eb}
    .button.danger {background:#b74353}
    .page-head {display:flex;align-items:center;justify-content:space-between;gap:18px;margin:4px 0 24px}
    .page-head p {color:var(--sub);margin-top:6px}
    .actions {display:flex;gap:8px;align-items:center}
    .stats {display:flex;gap:12px;margin-bottom:23px}
    .stat {border:1px solid var(--line);background:white;border-radius:15px;padding:15px 18px;min-width:185px}
    .stat span {font-size:12px;color:var(--sub)}
    .stat strong {display:block;font-size:23px;letter-spacing:-.5px;margin-top:2px}
    .calendar-shell {background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 7px 30px rgba(26,39,72,.035)}
    .calendar-header {display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line)}
    .calendar-header strong {font-size:16px}
    .week-nav {display:flex;gap:8px;align-items:center}
    .week-nav a {border:1px solid var(--line);border-radius:8px;padding:6px 10px;color:#45516a}
    .calendar-scroll {overflow-x:auto}
    .week-grid {display:grid;grid-template-columns:58px repeat(7,minmax(135px,1fr));min-width:1080px}
    .day-heading {height:64px;display:grid;place-items:center;border-bottom:1px solid var(--line);border-left:1px solid var(--line);background:#fff}
    .day-heading em {font-style:normal;font-size:11px;color:var(--sub);text-transform:uppercase;letter-spacing:1px}
    .day-heading strong {font-size:20px;font-weight:650}
    .day-heading.today {background:#f4f5ff;color:var(--brand)}
    .hour-header {border-bottom:1px solid var(--line)}
    .time-rail {height:924px;position:relative;background:#fafbfc}
    .hour {height:66px;position:relative;top:-8px;text-align:center;color:#8b94a5;font-size:11px}
    .day-body {height:924px;position:relative;border-left:1px solid var(--line);background:repeating-linear-gradient(to bottom,#fff 0,#fff 65px,#edf0f4 65px,#edf0f4 66px);cursor:crosshair}
    .day-body.today {background:repeating-linear-gradient(to bottom,#fafaff 0,#fafaff 65px,#e6eafd 65px,#e6eafd 66px)}
    .selection-preview {position:absolute;left:3px;right:3px;pointer-events:none;z-index:5;border:1px dashed var(--brand);border-radius:8px;background:#5268ca33;box-shadow:inset 0 0 0 1px #fff8}
    .duration-picks {display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
    .duration-pick {background:white;color:#4a556e;border:1px solid #dbe1e9;padding:7px 11px;border-radius:9px;font-size:12px;cursor:pointer}
    .duration-pick[aria-pressed="true"] {background:#edf0ff;color:var(--brand);border-color:#9ba8ea;font-weight:750}
    .duration-input-row {display:flex;align-items:center;gap:12px;color:var(--sub);font-size:12px}
    .duration-input-row input {width:105px!important}
    .schedule-summary {border-radius:11px;background:#f2f4fa;padding:13px 15px;display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:12px;color:#64718a}
    .schedule-summary strong {color:#273148;font-size:13px}

    .event {position:absolute;left:5px;right:5px;overflow:hidden;border-radius:8px;border-left:3px solid var(--event-color);background:color-mix(in srgb,var(--event-color) 12%,white);padding:5px 8px;color:#263044;display:flex;flex-direction:column;justify-content:center;gap:2px;transition:box-shadow .15s}
    .event:hover {box-shadow:0 4px 16px #2222;z-index:3}
    .event strong {display:block;flex-shrink:0;font-size:12px;font-weight:750;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .event small {display:block;flex-shrink:0;font-size:10px;line-height:1.2;color:#536078}
    .event .category {display:block;flex-shrink:0;font-size:10px;line-height:1.2;color:var(--event-color);font-weight:750}
    .help {font-size:12px;padding:13px 20px;color:var(--sub);border-top:1px solid var(--line)}
    .flash {padding:12px 16px;border-radius:10px;background:#e6f5ee;color:#236b54;margin-bottom:18px}
    .flash.alert {background:#fff0ef;color:#a33c44}
    .form-card {max-width:580px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px;margin:28px auto;box-shadow:0 10px 30px #14213708}
    .form-card h1 {font-size:26px;margin-bottom:7px}
    .form-card>p {color:var(--sub);margin-bottom:24px}
    .field {margin:17px 0}
    .field label {display:block;font-size:12px;font-weight:750;margin-bottom:7px}
    .field input,.field select,.field textarea {width:100%;border:1px solid #dbe1e9;background:#fff;padding:11px 12px;border-radius:9px;outline:none}
    .field input:focus,.field textarea:focus,.field select:focus {border-color:var(--brand);box-shadow:0 0 0 3px #5268ca18}
    .field textarea {min-height:90px}
    .field-row {display:grid;grid-template-columns:1fr 1fr;gap:15px}
    .error-list {color:#ae3e4d;background:#fff2f4;border-radius:9px;padding:12px 14px;margin-bottom:12px}
    .form-actions {display:flex;gap:9px;align-items:center;margin-top:23px}
    .form-actions .button {min-width:120px}
    .form-note {font-size:12px;color:var(--sub);margin-top:18px}
    .field-hint {font-size:12px;color:var(--sub);margin-top:6px}
    .tag-suggestions,.tags-inline {display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
    .tag-pill {display:inline-flex;align-items:center;border-radius:7px;border:1px solid #dce2f1;background:#f3f5fb;color:#52627a;padding:4px 9px;font-size:11px;line-height:1.5;cursor:pointer}
    a.tag-pill:hover,button.tag-pill:hover {background:#e9edfb;border-color:#aab7dc;color:#364f9c}
    .search-card {background:white;border:1px solid var(--line);border-radius:15px;padding:21px;margin:20px 0}
    .search-form {display:flex;align-items:end;gap:10px;flex-wrap:wrap}
    .search-form .field {margin:0;flex:1;min-width:180px}
    .search-form .field input,.search-form .field select {width:100%;border:1px solid #dbe1e9;background:white;border-radius:9px;padding:11px 12px}
    .result-list {display:grid;gap:9px}
    .result {padding:15px 17px;border-radius:12px;border:1px solid var(--line);background:white;display:flex;gap:12px;align-items:start;justify-content:space-between}
    .result strong {font-size:14px}.result small {display:block;color:var(--sub);margin-top:4px}
    .result .tags-inline {margin-top:7px}
    .result-notes {color:#536078;font-size:12px;margin-top:5px;overflow-wrap:anywhere}

    @media (max-width:720px) {
      .topbar{padding:0 17px}.account span{display:none}
      main{padding:23px 14px}.page-head{align-items:flex-start;flex-direction:column}
      .page-head h1{font-size:26px}.stats{flex-wrap:wrap}.stat{flex:1;min-width:140px}
      .calendar-header{padding:14px;flex-wrap:wrap;gap:10px}
      .form-card{margin:15px auto;padding:20px}.field-row{grid-template-columns:1fr}
    }

    /* Planner time-block editor: compact, tactile, accessible */
    .editor-shell {max-width:1020px;margin:4px auto 46px}
    .editor-page-head {display:flex;align-items:end;justify-content:space-between;gap:20px;margin:10px 0 24px}
    .editor-page-head h1 {font-size:34px;letter-spacing:-1.4px;margin:9px 0 7px}
    .editor-page-head p {font-size:14px;color:var(--sub)}
    .editor-eyebrow {font-size:10px;font-weight:800;letter-spacing:1.9px;color:#64708e}
    .eyebrow-dot {display:inline-block;width:7px;height:7px;border-radius:50%;background:#6073d5;margin-right:7px}
    .editor-back {color:#606c83;font-size:12px;font-weight:650;border:1px solid #e0e5ee;background:white;padding:10px 13px;border-radius:10px;white-space:nowrap}
    .editor-back:hover,.editor-cancel:hover {background:#f5f7fb}
    .editor-form {border:1px solid #e2e7f0;border-radius:20px;background:#fff;overflow:hidden;box-shadow:0 16px 48px rgba(29,43,77,.055)}
    .editor-grid {display:grid;grid-template-columns:1fr 1fr}
    .editor-section {padding:29px 32px 30px;min-width:0}
    .editor-section-activity {border-right:1px solid #e9edf4}
    .editor-section-time {background:linear-gradient(155deg,#fbfcff,#f6f8fe)}
    .editor-section-heading {display:flex;gap:12px;align-items:center;margin-bottom:28px}
    .editor-step {width:35px;height:35px;display:grid;place-items:center;border:1px solid #dee3f4;border-radius:12px;background:#eef1fc;color:#5367c1;font-size:12px;font-weight:800}
    .editor-section-heading h2 {font-size:17px;letter-spacing:-.5px;color:#1e283b}
    .editor-section-heading p {font-size:12px;color:#818b9e;margin-top:1px}
    .editor-field {margin-bottom:21px}
    .editor-field label,.editor-categories legend {display:block;font-size:12px;color:#354056;font-weight:750;margin:0 0 9px}
    .editor-optional {color:#909aab;font-weight:500;margin-left:4px}
    .editor-field input[type="text"],.editor-field input[type="date"],.editor-field input[type="time"],.editor-field input[type="number"],.editor-field textarea {display:block;width:100%;min-width:0;border:1px solid #dce3ee;border-radius:11px;background:#fff;color:#1c2638;padding:12px 13px;min-height:46px;outline:none;transition:border .15s,box-shadow .15s}
    .editor-field input:focus,.editor-field textarea:focus,.tag-editor:focus-within {border-color:#7485df;box-shadow:0 0 0 4px rgba(83,104,202,.10);outline:none}
    .editor-field input::placeholder,.editor-field textarea::placeholder {color:#a1a9b7}
    .editor-title-field input[type="text"] {font-size:15px;font-weight:600;height:52px}
    .editor-categories {border:0;padding:0;margin:0 0 21px}
    .editor-category-grid {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .editor-category-choice {display:block;position:relative;margin:0!important;cursor:pointer}
    .editor-category-choice input {position:absolute;width:1px;height:1px;opacity:0;top:50%;left:50%}
    .category-choice-inner {border:1px solid #e1e6ef;background:#fff;border-radius:11px;display:flex;align-items:center;gap:9px;min-height:45px;padding:0 13px;color:#48556d;font-size:12px;font-weight:680;transition:all .12s}
    .category-color {width:10px;height:10px;border-radius:50%;background:var(--category-color);box-shadow:0 0 0 3px color-mix(in srgb,var(--category-color) 13%,white);flex:0 0 auto}
    .editor-category-choice:hover .category-choice-inner {border-color:#b1bdd5;background:#fafbfe}
    .editor-category-choice input:checked + .category-choice-inner {background:color-mix(in srgb,var(--category-color) 6%,white);border-color:var(--category-color);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--category-color) 22%,transparent);color:#1d2b43}
    .editor-category-choice input:focus-visible + .category-choice-inner {outline:3px solid #9ba8f5;outline-offset:2px}
    .editor-hint {color:#8a94a6;font-size:11px;line-height:1.45;margin:7px 0 0}
    .tag-editor {border:1px solid #dce3ee;border-radius:11px;background:#fff;min-height:48px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;padding:6px 9px;cursor:text}
    .tag-editor .tag-source {border:0;box-shadow:none;min-height:32px;padding:3px 5px;width:100%;font-size:12px}
    .tag-editor .tag-source:focus {border:0;box-shadow:none}
    .tag-editor.is-enhanced .tag-source {display:none}
    .tag-editor .tag-entry {display:block;border:0;box-shadow:none;outline:0;min-width:125px;flex:1;padding:5px 3px;height:30px;background:transparent;color:#2a3548;font-size:12px}
    .tag-editor .tag-entry[hidden] {display:none}
    .tag-editor-chips {display:flex;gap:5px;flex-wrap:wrap;max-width:100%}
    .editor-tag-chip {display:inline-flex;align-items:center;gap:5px;padding:4px 7px;border:1px solid #dbe3fb;background:#eef2fc;border-radius:7px;font-size:11px;color:#5262ac;font-weight:700;max-width:100%}
    .editor-tag-chip span {overflow-wrap:anywhere}
    .editor-tag-chip button {border:0;background:none;color:#7d89b4;font-size:16px;line-height:1;padding:0 1px;cursor:pointer}
    .editor-tag-chip button:hover {color:#b93e4d}
    .editor-tag-suggestions {margin-top:13px}
    .editor-tag-suggestions>span {font-size:10px;letter-spacing:.2px;color:#8a94a6;font-weight:700}
    .editor-tag-suggestions .tag-suggestions {margin-top:7px}
    .editor-tag-message {font-size:11px;color:#b74452;margin:6px 0 0}
    .editor-tag-message:empty {display:none}
    .editor-time-fields {display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .duration-picks {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:0 0 13px}
    .duration-pick {border-radius:10px;border:1px solid #dfe5f0;background:#fff;color:#627087;font-size:12px;font-weight:650;padding:10px 4px;min-height:40px}
    .duration-pick:hover {border-color:#a6b3da;color:#384c92;background:#fafbff}
    .duration-pick[aria-pressed="true"] {border-color:#7384d8;background:#eaf0ff;color:#445cbb;box-shadow:0 0 0 1px #7384d820}
    .duration-pick:focus-visible,.editor-submit:focus-visible,.editor-cancel:focus-visible,.editor-back:focus-visible {outline:3px solid #95a5ee;outline-offset:2px}
    .editor-custom-duration {display:flex;align-items:center;justify-content:space-between;gap:12px;color:#8a94a6;font-size:11px}
    .editor-minutes-input {display:flex;align-items:center;gap:8px}
    .editor-minutes-input input {min-height:40px!important;width:77px!important;text-align:center;padding:6px!important}
    .editor-minutes-input span {font-size:12px;color:#7d8699}
    .editor-time-preview {margin-top:26px;padding:18px;background:#e9eefc;border:1px solid #dae3fa;border-radius:13px;display:flex;align-items:center;gap:14px;min-height:82px}
    .editor-preview-icon {display:grid;place-items:center;background:#fff;border-radius:11px;width:39px;height:39px;flex:0 0 39px;font-size:22px;color:#566bc3}
    .editor-time-preview div:last-child {min-width:0}
    .editor-time-preview span {display:block;font-size:11px;color:#687aaa;font-weight:650;margin-bottom:4px}
    .editor-time-preview strong {font-size:16px;letter-spacing:-.3px;color:#253971;overflow-wrap:anywhere}
    .editor-time-preview.is-invalid {background:#fff3f1;border-color:#e8c0ba}
    .editor-time-preview.is-invalid strong {color:#aa4b43;font-size:12px}
    .editor-details {border-top:1px solid #e9edf4}
    .editor-details>summary {list-style:none;cursor:pointer;display:flex;gap:12px;align-items:center;min-height:62px;padding:16px 31px;font-size:13px;font-weight:750;color:#44526a}
    .editor-details>summary::-webkit-details-marker {display:none}
    .editor-details>summary:focus-visible {outline:3px solid #9aabed;outline-offset:-3px}
    .editor-details-symbol {font-size:21px;color:#6e7fc8;font-weight:400;line-height:1}
    .editor-details[open] .editor-details-symbol {transform:rotate(45deg)}
    .editor-details-caption {font-size:11px;color:#98a0b0;font-weight:500;margin-left:auto}
    .editor-details-content {padding:4px 32px 18px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .editor-details-content .editor-field {margin:0}
    .editor-details-content textarea {min-height:100px}
    .editor-actual-row {display:flex;align-items:center;gap:12px}
    .editor-actual-row input {width:90px!important}
    .editor-actual-row span {font-size:11px;color:#8b94a4}
    .editor-footer {display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 30px;border-top:1px solid #e9edf4;background:#fff}
    .editor-footer-help {font-size:11px;color:#9099a8}
    .editor-footer-actions {display:flex;align-items:center;gap:10px}
    .editor-cancel {border:1px solid #e0e6ef;background:#fff;border-radius:10px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:0 17px;color:#5b677b;font-size:12px;font-weight:700}
    .editor-submit {border:0;background:#5268ca;color:white;border-radius:10px;min-height:44px;padding:0 22px;font-size:13px;font-weight:750;box-shadow:0 5px 12px rgba(64,85,190,.16);cursor:pointer}
    .editor-submit:hover {background:#445ab9}
    .editor-submit:disabled {opacity:.48;cursor:not-allowed;box-shadow:none}
    .editor-delete-zone {display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:18px;padding:4px 8px;color:#8a94a5}
    .editor-delete-zone strong {font-size:12px;color:#7e8798}
    .editor-delete-zone p {font-size:11px;margin-top:2px}
    .editor-delete-button {border:1px solid #eedcdf;color:#b14c58;background:transparent;font-size:11px;font-weight:700;border-radius:9px;padding:9px 12px;cursor:pointer}
    .editor-delete-button:hover {background:#fff1f2}
    .editor-error {margin:18px 26px 0;border:1px solid #f4cfd3;border-radius:12px;background:#fff5f5;padding:14px 18px;color:#a3374c;font-size:12px}
    .editor-error ul {margin:6px 0 0;padding-left:18px}
    @media (max-width:860px) {
      .editor-grid {grid-template-columns:1fr}
      .editor-section-activity {border-right:0;border-bottom:1px solid #e9edf4}
      .editor-section-time {background:#f9faff}
    }
    @media (max-width:600px) {
      .editor-shell {margin:0 auto 25px}
      .editor-page-head {align-items:start;margin-bottom:18px}
      .editor-page-head h1 {font-size:27px}
      .editor-back {font-size:11px;padding:8px}
      .editor-section {padding:23px 19px}
      .editor-section-heading {margin-bottom:22px}
      .editor-form {border-radius:15px}
      .editor-time-fields {gap:9px}
      .editor-details>summary {padding:16px 19px;flex-wrap:wrap}
      .editor-details-caption {margin-left:0}
      .editor-details-content {grid-template-columns:1fr;padding:0 19px 20px}
      .editor-footer {padding:14px 19px;align-items:stretch;flex-direction:column}
      .editor-footer-actions {width:100%}
      .editor-footer-actions>* {flex:1;text-align:center}
      .editor-delete-zone {padding:4px}
    }

  </style>
</head>
<body>
  <header class="topbar">
    <a href="<%= root_path %>" class="brand"><span class="brand-mark">P</span>Planner</a>
    <% if current_user %>
      <div class="nav-links"><%= link_to "Planning", root_path, class: controller_name == "planner" && action_name == "index" ? "active" : "" %><%= link_to "Recherche", recherche_path, class: action_name == "search" ? "active" : "" %><%= link_to "+ Créneau", new_time_block_path %></div>
      <div class="account"><span><%= current_user.email %></span><%= button_to "Déconnexion", session_path, method: :delete %></div>
    <% end %>
  </header>
  <main>
    <% if notice %><div class="flash"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert"><%= alert %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
