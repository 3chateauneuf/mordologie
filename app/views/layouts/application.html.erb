<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f6f9">
  <title>Planner — Organiser le temps</title>
    <link rel="stylesheet" href="/styles/foundation.css">
  <link rel="stylesheet" href="/styles/time-block-editor.css">
  <link rel="stylesheet" href="/styles/mobile.css">
  <link rel="stylesheet" href="/styles/dialogs.css">
  <script src="/planner-dialog.js" defer></script>
  <% if controller_name == "time_blocks" %>
    <script src="/scripts/time-block-form.js" defer></script>
  <% elsif controller_name == "planner" && action_name == "index" %>
    <script src="/scripts/week-calendar.js" defer></script>
  <% end %>
</head>
<body class="<%= controller_name == 'time_blocks' ? 'is-editor-page' : '' %> <%= controller_name == 'time_blocks' && %w[new create edit update].include?(action_name) ? 'is-dialog-page' : '' %>">
  <header class="topbar">
    <a href="<%= root_path %>" class="brand"><span class="brand-mark">P</span>Planner</a>
    <% if current_user %>
      <div class="nav-links"><%= link_to "Planning", root_path, class: controller_name == "planner" && action_name == "index" ? "active" : "" %><%= link_to "Recherche", recherche_path, class: action_name == "search" ? "active" : "" %><%= link_to "+ Créneau", new_time_block_path %></div>
      <div class="account"><span><%= current_user.email %></span><%= button_to "Déconnexion", session_path, method: :delete %></div>
      <details class="mobile-menu">
        <summary aria-label="Ouvrir le menu">☰</summary>
        <div class="mobile-menu-panel">
          <%= link_to "Planning", root_path %>
          <%= link_to "Recherche", recherche_path %>
          <%= link_to "Nouveau créneau", new_time_block_path %>
          <%= button_to "Déconnexion", session_path, method: :delete %>
        </div>
      </details>
    <% end %>
  </header>
  <main>
    <% if notice %><div class="flash"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert"><%= alert %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
