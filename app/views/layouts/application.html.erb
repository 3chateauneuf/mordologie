<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f6f9">
  <title>Planner — Organiser le temps</title>
  <style>
    :root { --ink:#151c2c; --sub:#6c7688; --line:#e7ebf1; --bg:#f5f6f9; --brand:#5268ca; }
    * {box-sizing:border-box}
    body {margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
    a {color:inherit;text-decoration:none}
    button,input,select,textarea {font:inherit}
    button {cursor:pointer}
    .topbar {height:72px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 32px;gap:20px}
    .brand {display:flex;align-items:center;gap:11px;font-size:21px;letter-spacing:-.8px;font-weight:800}
    .brand-mark {display:grid;place-items:center;width:34px;height:34px;border-radius:11px;color:white;background:var(--brand);font-size:20px}
    .nav-links {display:flex;gap:12px;align-items:center}
    .nav-links a {color:#5e687c;padding:8px 10px;border-radius:8px}
    .nav-links a.active {color:var(--brand);background:#eff1fe;font-weight:700}
    .account {display:flex;gap:12px;align-items:center;font-size:12px;color:var(--sub)}
    .account button {border:0;background:none;color:#667085}
    main {max-width:1480px;margin:0 auto;padding:28px 30px}
    h1 {font-size:30px;letter-spacing:-1px;line-height:1.18;margin:0}
    .planner-page-title {display:flex;align-items:center;flex-wrap:wrap;gap:12px}
    .week-number {display:inline-flex;align-items:center;background:#e7ebf8;border:1px solid #d5ddf3;border-radius:9px;padding:6px 10px;color:#455aaf;font-size:13px;font-weight:750;letter-spacing:0;white-space:nowrap}

    h2 {font-size:16px;margin:0}
    p {margin:0}
    .muted {color:var(--sub)}
    .button {display:inline-flex;align-items:center;gap:8px;justify-content:center;border:1px solid transparent;border-radius:10px;padding:11px 16px;background:var(--brand);color:white;font-weight:700;cursor:pointer}
    .button.secondary {background:white;color:var(--ink);border-color:#dfe4eb}
    .button.danger {background:#b74353}
    .page-head {display:flex;align-items:center;justify-content:space-between;gap:18px;margin:4px 0 24px}
    .page-head p {color:var(--sub);margin-top:6px}
    .actions {display:flex;gap:8px;align-items:center}
    .stats {display:flex;gap:12px;margin-bottom:23px}
    .stat {border:1px solid var(--line);background:white;border-radius:15px;padding:15px 18px;min-width:185px}
    .stat span {font-size:12px;color:var(--sub)}
    .stat strong {display:block;font-size:23px;letter-spacing:-.5px;margin-top:2px}
    .calendar-shell {background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 7px 30px rgba(26,39,72,.035)}
    .calendar-header {display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line)}
    .calendar-header strong {font-size:16px}
    .week-nav {display:flex;gap:8px;align-items:center}
    .week-nav a {border:1px solid var(--line);border-radius:8px;padding:6px 10px;color:#45516a}
    .calendar-scroll {overflow-x:auto}
    .week-grid {display:grid;grid-template-columns:58px repeat(7,minmax(135px,1fr));min-width:1080px}
    .day-heading {height:64px;display:grid;place-items:center;border-bottom:1px solid var(--line);border-left:1px solid var(--line);background:#fff}
    .day-heading em {font-style:normal;font-size:11px;color:var(--sub);text-transform:uppercase;letter-spacing:1px}
    .day-heading strong {font-size:20px;font-weight:650}
    .day-heading.today {background:#f4f5ff;color:var(--brand)}
    .hour-header {border-bottom:1px solid var(--line)}
    .time-rail {height:924px;position:relative;background:#fafbfc}
    .hour {height:66px;position:relative;top:-8px;text-align:center;color:#8b94a5;font-size:11px}
    .day-body {height:924px;position:relative;border-left:1px solid var(--line);background:repeating-linear-gradient(to bottom,#fff 0,#fff 65px,#edf0f4 65px,#edf0f4 66px);cursor:crosshair}
    .day-body.today {background:repeating-linear-gradient(to bottom,#fafaff 0,#fafaff 65px,#e6eafd 65px,#e6eafd 66px)}
    .selection-preview {position:absolute;left:3px;right:3px;pointer-events:none;z-index:5;border:1px dashed var(--brand);border-radius:8px;background:#5268ca33;box-shadow:inset 0 0 0 1px #fff8}
    .duration-picks {display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
    .duration-pick {background:white;color:#4a556e;border:1px solid #dbe1e9;padding:7px 11px;border-radius:9px;font-size:12px;cursor:pointer}
    .duration-pick[aria-pressed="true"] {background:#edf0ff;color:var(--brand);border-color:#9ba8ea;font-weight:750}
    .duration-input-row {display:flex;align-items:center;gap:12px;color:var(--sub);font-size:12px}
    .duration-input-row input {width:105px!important}
    .schedule-summary {border-radius:11px;background:#f2f4fa;padding:13px 15px;display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:12px;color:#64718a}
    .schedule-summary strong {color:#273148;font-size:13px}

    .event {position:absolute;left:5px;right:5px;overflow:hidden;border-radius:8px;border-left:3px solid var(--event-color);background:color-mix(in srgb,var(--event-color) 12%,white);padding:5px 8px;color:#263044;display:flex;flex-direction:column;justify-content:center;gap:2px;transition:box-shadow .15s}
    .event:hover {box-shadow:0 4px 16px #2222;z-index:3}
    .event strong {display:block;flex-shrink:0;font-size:12px;font-weight:750;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .event small {display:block;flex-shrink:0;font-size:10px;line-height:1.2;color:#536078}
    .event .category {display:block;flex-shrink:0;font-size:10px;line-height:1.2;color:var(--event-color);font-weight:750}
    .help {font-size:12px;padding:13px 20px;color:var(--sub);border-top:1px solid var(--line)}
    .flash {padding:12px 16px;border-radius:10px;background:#e6f5ee;color:#236b54;margin-bottom:18px}
    .flash.alert {background:#fff0ef;color:#a33c44}
    .form-card {max-width:580px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:30px;margin:28px auto;box-shadow:0 10px 30px #14213708}
    .form-card h1 {font-size:26px;margin-bottom:7px}
    .form-card>p {color:var(--sub);margin-bottom:24px}
    .field {margin:17px 0}
    .field label {display:block;font-size:12px;font-weight:750;margin-bottom:7px}
    .field input,.field select,.field textarea {width:100%;border:1px solid #dbe1e9;background:#fff;padding:11px 12px;border-radius:9px;outline:none}
    .field input:focus,.field textarea:focus,.field select:focus {border-color:var(--brand);box-shadow:0 0 0 3px #5268ca18}
    .field textarea {min-height:90px}
    .field-row {display:grid;grid-template-columns:1fr 1fr;gap:15px}
    .error-list {color:#ae3e4d;background:#fff2f4;border-radius:9px;padding:12px 14px;margin-bottom:12px}
    .form-actions {display:flex;gap:9px;align-items:center;margin-top:23px}
    .form-actions .button {min-width:120px}
    .form-note {font-size:12px;color:var(--sub);margin-top:18px}
    .field-hint {font-size:12px;color:var(--sub);margin-top:6px}
    .tag-suggestions,.tags-inline {display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
    .tag-pill {display:inline-flex;align-items:center;border-radius:7px;border:1px solid #dce2f1;background:#f3f5fb;color:#52627a;padding:4px 9px;font-size:11px;line-height:1.5;cursor:pointer}
    a.tag-pill:hover,button.tag-pill:hover {background:#e9edfb;border-color:#aab7dc;color:#364f9c}
    .search-card {background:white;border:1px solid var(--line);border-radius:15px;padding:21px;margin:20px 0}
    .search-form {display:flex;align-items:end;gap:10px;flex-wrap:wrap}
    .search-form .field {margin:0;flex:1;min-width:180px}
    .search-form .field input,.search-form .field select {width:100%;border:1px solid #dbe1e9;background:white;border-radius:9px;padding:11px 12px}
    .result-list {display:grid;gap:9px}
    .result {padding:15px 17px;border-radius:12px;border:1px solid var(--line);background:white;display:flex;gap:12px;align-items:start;justify-content:space-between}
    .result strong {font-size:14px}.result small {display:block;color:var(--sub);margin-top:4px}
    .result .tags-inline {margin-top:7px}
    .result-notes {color:#536078;font-size:12px;margin-top:5px;overflow-wrap:anywhere}

    @media (max-width:720px) {
      .topbar{padding:0 17px}.account span{display:none}
      main{padding:23px 14px}.page-head{align-items:flex-start;flex-direction:column}
      .page-head h1{font-size:26px}.stats{flex-wrap:wrap}.stat{flex:1;min-width:140px}
      .calendar-header{padding:14px;flex-wrap:wrap;gap:10px}
      .form-card{margin:15px auto;padding:20px}.field-row{grid-template-columns:1fr}
    }


    /* Compact Planner editor. Single flow from 320px to desktop. */
    .editor-shell {max-width:620px;margin:0 auto 60px}
    .editor-page-head {display:flex;align-items:center;gap:16px;margin:12px 0 19px}
    .editor-page-head h1 {font-size:26px;letter-spacing:-.8px}
    .editor-back {font-size:12px;font-weight:680;color:#64718b;padding:8px 10px;border:1px solid #dfe5ee;border-radius:9px;background:white;white-space:nowrap}
    .editor-back:hover {color:#31469b;background:#f5f7fc}
    .editor-form {background:#fff;border:1px solid #e1e6ef;border-radius:16px;overflow:hidden;box-shadow:0 12px 32px rgba(30,42,70,.04)}
    .editor-core {padding:25px 28px 17px}
    .editor-field {min-width:0;margin:0 0 19px}
    .editor-field>label,.editor-categories>legend {display:block;color:#354054;font-weight:740;font-size:12px;margin:0 0 7px}
    .editor-optional {font-weight:450;color:#8c95a4}
    .editor-field input[type="text"],.editor-field input[type="date"],.editor-field input[type="time"],.editor-field input[type="number"],.editor-field textarea {width:100%;min-width:0;min-height:46px;border:1px solid #dce3ed;border-radius:10px;padding:10px 12px;background:#fff;color:#1e2a3e;outline:none;font-size:14px}
    .editor-field input[type="text"]:focus,.editor-field input[type="date"]:focus,.editor-field input[type="time"]:focus,.editor-field input[type="number"]:focus,.editor-field textarea:focus {border-color:#6c7ed5;box-shadow:0 0 0 3px #5268ca17}
    .editor-title-field input[type="text"] {font-size:16px;font-weight:650;min-height:52px}
    .editor-field input::placeholder,.editor-field textarea::placeholder {color:#9aa4b4;font-weight:400}
    .editor-schedule-row {display:grid;grid-template-columns:1.3fr 1fr;gap:12px;min-width:0}
    .duration-picks {display:flex;gap:6px;flex-wrap:wrap;margin:0}
    .duration-pick {font-size:12px;font-weight:680;white-space:nowrap;flex:1 1 70px;min-width:62px;min-height:42px;border-radius:9px;border:1px solid #dee4ee;background:white;color:#4f5c72;padding:8px 7px}
    .duration-pick:hover {background:#f8f9fe;border-color:#a8b4da}
    .duration-pick[aria-pressed="true"] {border-color:#7586d8;color:#4055b0;background:#edf1fd}
    .editor-duration-bottom {display:flex;justify-content:space-between;gap:14px;align-items:center;margin-top:12px;flex-wrap:wrap}
    .editor-custom-duration {display:flex;align-items:center;gap:8px;white-space:nowrap;font-size:12px;color:#68748a}
    .editor-custom-duration input[type="number"] {width:65px;min-height:36px;text-align:center;padding:4px!important;font-size:13px}
    .editor-end {display:flex;align-items:center;gap:8px;font-size:12px;white-space:nowrap;color:#728099}
    .editor-end strong {font-size:15px;color:#425abd}
    .editor-end.is-invalid strong {font-size:12px;color:#b14450}
    .editor-categories {border:0;padding:0;margin-bottom:20px;min-width:0}
    .editor-category-grid {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
    .editor-category-choice {display:block;position:relative;cursor:pointer;min-width:0}
    .editor-category-choice input {position:absolute;opacity:0;width:1px;height:1px;left:50%;top:50%}
    .category-choice-inner {display:flex;align-items:center;justify-content:center;gap:6px;border:1px solid #e0e5ef;border-radius:9px;min-height:43px;padding:4px 7px;font-size:11px;font-weight:690;color:#4c5970;background:white;white-space:nowrap}
    .category-color {flex:0 0 8px;width:8px;height:8px;border-radius:50%;background:var(--category-color)}
    .editor-category-choice input:checked + .category-choice-inner {border-color:var(--category-color);background:color-mix(in srgb,var(--category-color) 7%,white);color:#27354d}
    .editor-category-choice input:focus-visible + .category-choice-inner {outline:3px solid #9ba8ed;outline-offset:2px}
    .tag-editor {border:1px solid #dce3ee;border-radius:10px;min-height:46px;display:flex;align-items:center;flex-wrap:wrap;gap:5px;padding:5px 9px;cursor:text}
    .tag-editor:focus-within {border-color:#6c7ed5;box-shadow:0 0 0 3px #5268ca17}
    .editor-field .tag-editor .tag-source {border:0;min-height:32px;padding:3px 5px;box-shadow:none;font-size:13px}
    .tag-editor.is-enhanced .tag-source {display:none}
    .tag-editor-chips {display:flex;flex-wrap:wrap;gap:5px;max-width:100%}
    .editor-tag-chip {display:inline-flex;align-items:center;gap:5px;padding:3px 5px 3px 8px;border:1px solid #dbe2f6;border-radius:7px;background:#f0f3fd;color:#4a60b3;font-size:12px;max-width:100%}
    .editor-tag-chip span {overflow-wrap:anywhere}
    .editor-tag-chip button {border:0;background:none;color:#6f7fb0;min-width:24px;min-height:27px;font-size:18px;line-height:1;cursor:pointer}
    .editor-field .tag-editor .tag-entry {border:0;box-shadow:none;outline:none;min-height:32px;height:32px;font-size:13px;flex:1;min-width:135px;padding:3px 5px}
    .editor-field .tag-editor .tag-entry[hidden] {display:none}
    .editor-tag-reuse {margin-top:7px}
    .editor-tag-reuse summary {display:inline-block;cursor:pointer;font-size:11px;color:#586ec0;font-weight:650;padding:4px 0}
    .editor-tag-reuse summary:focus-visible {outline:2px solid #95a2e0}
    .editor-tag-reuse .tag-suggestions {margin-top:7px}
    .editor-tag-reuse .tag-pill {min-height:34px}
    .editor-tag-message {margin:5px 0 0;font-size:12px;color:#ad3b4f}
    .editor-tag-message:empty {display:none}
    .editor-details {border-top:1px solid #e8ecf3}
    .editor-details>summary {display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 28px;list-style:none;cursor:pointer;font-size:12px;font-weight:750;color:#44536b;min-height:50px}
    .editor-details>summary::-webkit-details-marker {display:none}
    .editor-details>summary:before {content:"+";font-size:18px;font-weight:450;color:#667ac6}
    .editor-details[open]>summary:before {content:"−"}
    .editor-details>summary span {margin-left:auto;font-weight:450;font-size:11px;color:#9aa3b1}
    .editor-details>summary:focus-visible {outline:3px solid #95a2e0;outline-offset:-3px}
    .editor-details-content {display:grid;grid-template-columns:1fr 170px;gap:14px;padding:5px 28px 7px}
    .editor-details-content .editor-field {margin-bottom:14px}
    .editor-actual-row {display:flex;align-items:center;gap:7px;color:#8993a4;font-size:12px}
    .editor-actual-row input[type="number"] {width:100px}
    .editor-details-content textarea {resize:vertical;min-height:94px}
    .editor-footer {border-top:1px solid #e8ecf3;padding:15px 28px;display:flex;justify-content:flex-end}
    .editor-submit {border:0;border-radius:10px;background:#5268ca;color:white;font-size:13px;font-weight:750;min-height:46px;padding:0 25px;cursor:pointer}
    .editor-submit:hover {background:#4058b7}
    .editor-submit:disabled {opacity:.48;cursor:not-allowed}
    .editor-submit:focus-visible,.editor-back:focus-visible,.duration-pick:focus-visible {outline:3px solid #a0aff0;outline-offset:2px}
    .editor-delete-zone {text-align:right;margin:12px 3px}
    .editor-delete-button {border:0;background:transparent;text-decoration:underline;text-underline-offset:3px;font-size:12px;font-weight:600;color:#a35460;cursor:pointer;min-height:40px;padding:8px 9px}
    .editor-delete-button:hover {color:#9d3242}
    .editor-error {padding:12px 18px;border:1px solid #edd3d8;border-radius:10px;background:#fff4f5;color:#9b3345;margin:18px 28px 0;font-size:12px}
    .editor-error ul {margin:5px 0 0;padding-left:18px}
    @media (max-width:720px) {
      .topbar {height:60px;padding:0 16px;gap:8px}
      .topbar .brand {font-size:19px}
      body.is-editor-page .topbar .nav-links {display:none}
      body.is-editor-page .topbar .account {margin-left:auto}
      body.is-editor-page .topbar .account button {font-size:12px}
      .editor-page-head {margin:5px 0 16px}
      .editor-page-head h1 {font-size:24px}
      .editor-shell {max-width:100%;margin:0 auto 40px}
      .editor-core {padding:22px 20px 5px}
      .editor-form {border-radius:14px}
      .editor-details>summary {padding:14px 20px}
      .editor-details-content {padding:0 20px 10px;grid-template-columns:1fr}
      .editor-footer {padding:13px 20px}
    }
    @media (max-width:480px) {
      body.is-editor-page {background:white}
      body.is-editor-page main {padding:10px 0 90px}
      .editor-shell {margin:0}
      .editor-page-head {padding:8px 16px 12px;margin:0;gap:10px}
      .editor-page-head h1 {font-size:21px}
      .editor-back {font-size:12px;padding:8px}
      .editor-form {border:0;border-radius:0;box-shadow:none}
      .editor-core {padding:14px 16px 1px}
      .editor-field {margin-bottom:17px}
      .editor-schedule-row {grid-template-columns:minmax(0,1.22fr) minmax(0,1fr);gap:9px}
      .editor-field input[type="date"],.editor-field input[type="time"] {font-size:14px;padding:8px 7px}
      .editor-category-grid {grid-template-columns:repeat(2,minmax(0,1fr))}
      .editor-details>summary {padding:14px 16px}
      .editor-details-content {padding:0 16px 8px}
      .duration-picks {gap:6px}
      .duration-pick {flex:1 1 29%;min-height:42px}
      .editor-footer {position:fixed;left:0;right:0;bottom:0;z-index:20;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1px solid #e4e9f2;box-shadow:0 -8px 24px #1827400c}
      .editor-submit {width:100%;min-height:49px;font-size:14px}
      .editor-delete-zone {margin:10px 16px 90px}
    }
    @media (max-width:355px) {
      .editor-page-head h1 {font-size:19px}
      .editor-schedule-row {grid-template-columns:1fr}
      .editor-schedule-row .editor-field:first-child {margin-bottom:9px}
    }


    /* Mobile app shell and focused one-day agenda */
    .mobile-menu,.mobile-day-picker,.mobile-calendar-label {display:none}
    @media (max-width:720px) {
      .topbar {height:58px;padding:0 14px;gap:8px}
      .topbar .nav-links,.topbar .account {display:none!important}
      .topbar .brand {font-size:19px;letter-spacing:-.55px}
      .topbar .brand-mark {width:33px;height:33px;border-radius:10px}
      .mobile-menu {display:block;position:relative;margin-left:auto;z-index:30}
      .mobile-menu>summary {display:grid;place-items:center;list-style:none;min-width:44px;min-height:44px;border-radius:10px;border:1px solid #e1e6ef;background:#fff;color:#33415c;font-size:20px;cursor:pointer}
      .mobile-menu>summary::-webkit-details-marker {display:none}
      .mobile-menu>summary:focus-visible {outline:3px solid #a8b6f1;outline-offset:2px}
      .mobile-menu-panel {position:absolute;right:0;top:calc(100% + 7px);min-width:190px;background:white;border-radius:13px;box-shadow:0 12px 35px #1c2b4650;border:1px solid #e1e6ef;padding:7px;display:grid;gap:2px}
      .mobile-menu-panel a,.mobile-menu-panel form button {display:block;width:100%;border:0;background:white;text-align:left;color:#35435b;padding:12px;border-radius:8px;font-size:13px;font-weight:600}
      .mobile-menu-panel a:hover,.mobile-menu-panel form button:hover {background:#f2f4fd}
      .mobile-menu-panel form {margin:0}
      main {padding:17px 12px}
      .page-head {gap:11px;margin:0 0 14px;align-items:stretch;flex-direction:column}
      .page-head h1 {font-size:25px;line-height:1.2}
      .page-head p {display:none}
      .week-number {font-size:11px;padding:5px 8px;border-radius:7px}
      .page-head .actions {width:100%;gap:0}
      .page-head .actions .button.secondary {display:none}
      .page-head .actions .button:not(.secondary) {width:100%;justify-content:center;min-height:43px;font-size:13px}
      .stats {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-bottom:13px}
      .stat {min-width:0;padding:11px 9px;border-radius:11px}
      .stat span {display:block;min-height:26px;font-size:10px;line-height:1.25}
      .stat strong {font-size:18px;line-height:1.25;margin-top:4px}
      .calendar-shell {border-radius:13px}
      .calendar-header {padding:11px 12px;gap:8px}
      .calendar-header strong {font-size:14px}
      .desktop-calendar-label {display:none}
      .mobile-calendar-label {display:inline}
      .week-nav {gap:5px}
      .week-nav a {min-height:39px;min-width:39px;display:grid;place-items:center;padding:5px 8px;font-size:12px}
      .mobile-day-picker {display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;padding:10px 8px 11px;background:#fff;border-bottom:1px solid #e9edf3}
      .mobile-day {min-width:0;min-height:64px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;border-radius:10px;color:#66748b;font-size:12px}
      .mobile-day-label {font-size:10px;font-weight:650}
      .mobile-day strong {font-size:17px;font-weight:700}
      .mobile-day.is-selected {background:#edf0fe;color:#485ec3}
      .mobile-day:focus-visible {outline:2px solid #6578d6;outline-offset:1px}
      .mobile-day-dot {width:4px;height:4px;border-radius:50%;background:#5268ca}
      .calendar-scroll {overflow-x:hidden;overflow-y:auto;max-height:min(60dvh,540px);overscroll-behavior:contain}
      .week-grid {min-width:0;grid-template-columns:50px minmax(0,1fr)}
      .day-heading:not(.is-active-day),.day-body:not(.is-active-day) {display:none}
      .hour-header {grid-column:1;position:sticky;top:0;z-index:6;background:#fff}
      .day-heading {grid-column:2;height:48px;position:sticky;top:0;z-index:6}
      .day-heading em {font-size:10px}
      .day-heading strong {font-size:16px}
      .time-rail {grid-column:1}
      .day-body {grid-column:2}
      .event {left:5px;right:6px}
      .help {padding:10px 12px;font-size:11px;line-height:1.45}
    }
    @media (max-width:480px) {
      .editor-schedule-row {grid-template-columns:1fr;gap:0}
      .editor-schedule-row .editor-field {margin-bottom:12px}
      .editor-field input[type="date"],.editor-field input[type="time"] {width:100%;max-width:100%;min-width:0;box-sizing:border-box;font-size:16px}
      .editor-field input[type="text"],.editor-field input[type="number"],.editor-field textarea {font-size:16px}
      .editor-category-grid {grid-template-columns:repeat(2,minmax(0,1fr))}
      .editor-footer {padding:10px 14px calc(10px + env(safe-area-inset-bottom))}
      .editor-submit {min-height:48px}
    }
    @media (max-width:340px) {
      .stats {gap:5px}
      .stat {padding:8px 6px}
      .stat span {font-size:9px}
      .stat strong {font-size:16px}
      .mobile-day-picker {gap:1px;padding-inline:5px}
      .mobile-day strong {font-size:15px}
      .week-nav a {min-width:35px}
    }

  </style>
</head>
<body class="<%= controller_name == 'time_blocks' ? 'is-editor-page' : '' %>">
  <header class="topbar">
    <a href="<%= root_path %>" class="brand"><span class="brand-mark">P</span>Planner</a>
    <% if current_user %>
      <div class="nav-links"><%= link_to "Planning", root_path, class: controller_name == "planner" && action_name == "index" ? "active" : "" %><%= link_to "Recherche", recherche_path, class: action_name == "search" ? "active" : "" %><%= link_to "+ Créneau", new_time_block_path %></div>
      <div class="account"><span><%= current_user.email %></span><%= button_to "Déconnexion", session_path, method: :delete %></div>
      <details class="mobile-menu">
        <summary aria-label="Ouvrir le menu">☰</summary>
        <div class="mobile-menu-panel">
          <%= link_to "Planning", root_path %>
          <%= link_to "Recherche", recherche_path %>
          <%= link_to "Nouveau créneau", new_time_block_path %>
          <%= button_to "Déconnexion", session_path, method: :delete %>
        </div>
      </details>
    <% end %>
  </header>
  <main>
    <% if notice %><div class="flash"><%= notice %></div><% end %>
    <% if alert %><div class="flash alert"><%= alert %></div><% end %>
    <%= yield %>
  </main>
</body>
</html>
